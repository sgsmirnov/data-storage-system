<?xml version='1.0' encoding='UTF-8'?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--                            -->
    <!-- Activity Feed Web Scripts  -->
    <!--                            -->

    <!-- Activity User Feed - to get activities feed for logged in user -->
    <bean id="webscript.org.alfresco.repository.activities.feed.userfeed.get" class="ru.atum.alfresco.ecm.web.scripts.DummyDeclarativeWebScript" parent="webscript"/>

    <!-- Activity Admin Feed - to get activities feed for specified user -->
    <bean id="webscript.org.alfresco.repository.activities.feed.userfeed-admin.get" class="ru.atum.alfresco.ecm.web.scripts.DummyDeclarativeWebScript" parent="webscript"/>

    <!-- Activity Site Feed - to get activities feed for given site, if private site then need to be a member or admin -->
    <bean id="webscript.org.alfresco.repository.activities.feed.sitefeed.get" class="ru.atum.alfresco.ecm.web.scripts.DummyDeclarativeWebScript" parent="webscript"/>

    <!--                            -->
    <!-- Activity Templates Storage -->
    <!--                            -->

    <bean id="webscript.org.alfresco.repository.activities.templates.get" class="ru.atum.alfresco.ecm.web.scripts.DummyDeclarativeWebScript" parent="webscript"/>

    <bean id="webscript.org.alfresco.repository.activities.template.get" class="ru.atum.alfresco.ecm.web.scripts.DummyDeclarativeWebScript" parent="webscript"/>

</beans>
